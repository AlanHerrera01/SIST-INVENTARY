# Desarrollo local. No incluir contraseñas ni tokens en este archivo.
COMPOSE_PROJECT_NAME=inventory-dev
FRONTEND_PORT=5173
BACKEND_PORT=8080
KEYCLOAK_PORT=8081
KEYCLOAK_MANAGEMENT_PORT=9000
MYSQL_PORT=3306
# Cambiar ambos si se cambia KEYCLOAK_PORT; issuer debe ser igual dentro/fuera de Docker.
KEYCLOAK_PUBLIC_URL=http://localhost:8081
OIDC_ISSUER_URI=http://localhost:8081/realms/inventory-dev
KEYCLOAK_ADMIN_USER=bootstrap-admin
LOG_LEVEL=INFO

